MEMORY
{
  /* NOTE 1 K = 1 KiBi = 1024 bytes */
  /* These values correspond to the ESP32 */
  IROM : ORIGIN = 0x400d0018, LENGTH = 0x330000 - 0x18
  IRAM : ORIGIN = 0x40080000, LENGTH = 0x20000
  DROM : ORIGIN = 0x3F400018, LENGTH = 0x400000 - 0x18
  DRAM : ORIGIN = 0x3FFB0000 + 0x8000, LENGTH = 0x50000 - 0x8000
  RTC_FAST : ORIGIN = 0x50000000, LENGTH = 0x2000
  RTC_SLOW : ORIGIN = 0x50001000, LENGTH = 0x1000
}
